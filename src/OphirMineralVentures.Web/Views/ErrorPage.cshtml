@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>
@{
    // Kept as IPublishedContent rather than a ModelsBuilder-generated ErrorPage class - this page
    // is reached via ErrorPageContentFinder (a last-chance content finder), not normal navigation,
    // so there's no guarantee ModelsBuilder has regenerated by the time this view is needed.
    Layout = "_Layout.cshtml";
}
<header class="page-hero">
    <div class="site px">
        <p class="eyebrow" style="color:var(--ore);font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 16px;">404</p>
        <h1>@(Model.Value<string>("heading"))</h1>
    </div>
</header>

<section>
    <div class="site px" style="text-align:center;">
        <div class="rte">@(Model.Value<IHtmlEncodedString>("message"))</div>
        <a href="/" class="btn btn-primary" style="margin-top:32px;display:inline-block;">Back to Home</a>
    </div>
</section>
